# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.
# Read by Settings (errand_agent/core/config.py) when the backend starts from backend/.

# --- Model provider keys (standard names; only the one for your chosen model is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini is priced in the cost table but its SDK is not installed yet.
GOOGLE_API_KEY=

# --- Which model the live agent uses (PydanticAI "<provider>:<model>" string)
# Blank = defaults: anthropic:claude-sonnet-5-5 (orchestrator) and
# anthropic:claude-haiku-5-5 (review reader), so ANTHROPIC_API_KEY alone is enough.
# e.g. anthropic:claude-opus-5-5, anthropic:claude-haiku-5-5, openai:gpt-6.1-sol
ERRAND_MODEL=
# Optional: the quarantined review reader's model. Blank = follows ERRAND_MODEL if you
# set one, else the Haiku default.
# ERRAND_REVIEW_MODEL=anthropic:claude-haiku-5-5

# --- Optional overrides (defaults shown)
# ERRAND_DATA_DIR=var
# ERRAND_MOCK_SEED=42
# ERRAND_MAX_MODEL_TURNS=8
# ERRAND_MAX_TOOL_CALLS=20
# ERRAND_MAX_RUN_SECONDS=60
# ERRAND_RECONCILE_INTERVAL_SECONDS=30
# ERRAND_CONTEXT_TOKEN_BUDGET=7500
# ERRAND_MEMORY_TOKEN_BUDGET=600
# ERRAND_SEED_DEMO_USER=true
